/*
  # Content-Security-Policy is set by functions/_middleware.js instead:
  # its connect-src must contain the configured GW_API_BASE origin,
  # which is only known at request time. (Two CSP headers would be
  # intersected by the browser, so it must not also live here.)
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
