# Local development secrets for `wrangler dev`.
# Copy this file to `.dev.vars` and fill in your own values.
# `.dev.vars` is gitignored — never commit real secrets.
#
# GATEWAY_TOKEN / ADMIN_TOKEN: any strings you like for local use.
# MASTER_KEY: must be 32 bytes in base64 — generate one with:
#   openssl rand -base64 32
GATEWAY_TOKEN=local-test-gateway-token
ADMIN_TOKEN=local-test-admin-token
MASTER_KEY=
